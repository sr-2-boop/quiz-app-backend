# Copy to .env and fill in the blanks. Never commit .env.
# The server validates this file at boot and refuses to start if anything required is missing or invalid.

NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/quiz

# Origin(s) of the frontend, comma-separated (used for CORS and Socket.IO)
CLIENT_ORIGIN=http://localhost:5173

# 32+ random bytes, e.g. the output of: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=6h

# true in production (HTTPS) so the auth cookie is only sent over TLS
COOKIE_SECURE=false
# lax for same-site deployments; use none with COOKIE_SECURE=true for separate cross-site deployments
COOKIE_SAME_SITE=lax

# Express "trust proxy": number of reverse proxies in front of the API (0 = none).
# Must be correct or rate limits see the proxy's IP instead of the client's.
TRUST_PROXY=0

# Google OAuth client id (Web application) used to verify admin sign-in ID tokens.
# Same value as VITE_GOOGLE_CLIENT_ID in frontend/.env
GOOGLE_CLIENT_ID=
# Optional: only accept Google Workspace accounts from this domain (the "hd" claim), e.g. uni.edu
GOOGLE_HOSTED_DOMAIN=
# Comma-separated Google emails allowed to sign in as admin
ADMIN_EMAILS=admin1@uni.edu,admin2@uni.edu

# Roster formats (defaults: URN like E25B002749, 10-digit Indian mobile)
URN_REGEX=^[A-Z]\d{2}[A-Z]\d{6}$
MOBILE_REGEX=^[6-9]\d{9}$

# Code execution for debug questions with grading "run". Keep false until a sandbox host exists.
CODE_EXECUTION_ENABLED=false
# piston or judge0 (self-hosted, on a separate host/network from the API and MongoDB)
SANDBOX_PROVIDER=piston
SANDBOX_URL=
SANDBOX_AUTH_TOKEN=
# Max sandbox runs in flight at once from this API instance
SANDBOX_MAX_CONCURRENCY=4
